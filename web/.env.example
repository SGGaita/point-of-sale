# Supabase Configuration (API-based connection)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Database Configuration
# Use the Supabase Database connection string (Settings → Database).
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Next.js Configuration (use localhost for local development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
